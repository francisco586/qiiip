# API de Claude (https://platform.claude.com → API Keys)
ANTHROPIC_API_KEY=sk-ant-...

# ── OPCIÓN A: Twilio Sandbox (la más fácil) ──────────────────────────
# Si defines TWILIO_ACCOUNT_SID, el bot usa Twilio y puedes ignorar las
# variables de Meta de abajo. SID y Auth Token: portal de twilio.com.
# TWILIO_ACCOUNT_SID=AC...
# TWILIO_AUTH_TOKEN=...
# TWILIO_WHATSAPP_FROM=whatsapp:+14155238886  # número del sandbox (default)

# ── OPCIÓN B: WhatsApp Cloud API de Meta ─────────────────────────────
# (https://developers.facebook.com → tu app → WhatsApp → API Setup)
WHATSAPP_TOKEN=EAAG...                 # Access token (temporal de 24h o permanente de System User)
WHATSAPP_PHONE_NUMBER_ID=123456789012345  # "Phone number ID" (NO es el número de teléfono)
WHATSAPP_VERIFY_TOKEN=elige-una-frase-secreta  # la inventas tú; debe coincidir al configurar el webhook

# Opcional
# CLAUDE_MODEL=claude-opus-4-8
# SYSTEM_PROMPT=Eres mi asistente personal...
# PORT=8000
